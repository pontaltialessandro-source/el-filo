# El Filò — regole di scadenza per la cache dei browser.
# Senza queste, Apache manda solo la data di modifica e ogni browser decide da sé
# quanto tenersi le pagine: una modifica caricata può non vedersi per giorni.

<IfModule mod_headers.c>

  # Le pagine: ricontrollate a ogni visita. Pesano pochi KB, e devono essere
  # sempre quelle vere (orari, pizza del mese, avvisi di chiusura).
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Stile e script: una settimana. Hanno già ?v=N nel link, quindi quando
  # cambiano si alza il numero e i browser li riscaricano subito.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # Immagini: una settimana. Non di più, perché se un giorno si sostituisce
  # una foto tenendo lo stesso nome, deve tornare visibile in tempi umani.
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # Font: un anno. Non cambiano mai, e sono il pezzo più pesante da scaricare.
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

</IfModule>
